# Use a SEPARATE bot for local development (create one via @BotFather — it's
# free and instant). Do not point this at the production bot's token: Telegram
# doesn't allow both a webhook and getUpdates polling on the same bot at once,
# so local_dev.py would immediately fail with a 409 Conflict against the
# production bot, which already has a webhook registered.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
ANTHROPIC_API_KEY=sk-ant-your-key
